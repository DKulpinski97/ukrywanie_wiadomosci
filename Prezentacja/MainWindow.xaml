<Window x:Class="UkrywanieWiadomosci.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UkrywanieWiadomosci"
        mc:Ignorable="d"
        Title="Menu główne"
        Height="431"
        Width="850"
        MinHeight="400"
        MinWidth="600">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Ścieżka do pliku PNG -->
        <Label Content="Ścieżka do pliku PNG" Grid.Row="0" Grid.Column="0"/>

        <TextBox x:Name="SciezkaDoPNGTextbox" Grid.Row="1" Grid.Column="0" IsReadOnly="True" Margin="0,0,10,5"/>

        <Button x:Name="WyborPNGButton" Content="Wybierz plik PNG" Grid.Row="2" Grid.Column="0" Margin="0,0,10,10"/>

        <!-- Ścieżka zapisu -->
        <Label Content="Ścieżka do miejsca zapisu" Grid.Row="3" Grid.Column="0"/>

        <TextBox x:Name="SciezkaDoZapisuTextbox" Grid.Row="4" Grid.Column="0" IsReadOnly="True" Margin="0,0,10,61"/>

        <Button x:Name="WyborSciezkiZapisuButton" Content="Wybierz miejsce zapisu obrazu" Grid.Row="4" Grid.Column="0" Margin="0,29,10,25"/>

        <!-- Wiadomość -->
        <Label Content="Wiadomość" Grid.Row="5" Grid.Column="0" VerticalAlignment="Top" Height="31"/>

        <TextBox x:Name="WiadomoscTextBox" Grid.Row="5" Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,31,10,0" Grid.RowSpan="3"/>

        <!-- Seed -->

        <Label Content="Seed dla algorytmu losowego" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

        <TextBox x:Name="SeedTextBox" Grid.Row="1" Grid.Column="1" Margin="0,2,0,5" Grid.RowSpan="2"/>

        <!-- Opcje działania -->
        <GroupBox Header="Co zrobić?" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <RadioButton x:Name="UkrycRadioBox" Content="Ukryć" GroupName="Operacja" IsChecked="True" Margin="0,3"/>

                <RadioButton x:Name="OdczytacRadioBox" Content="Odczytać" GroupName="Operacja" Margin="0,3"/>
            </StackPanel>
        </GroupBox>

        <!-- Rodzaj algorytmu -->
        <GroupBox Header="Rodzaj algorytmu" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <RadioButton x:Name="StandardRadioBox" Content="Standard" GroupName="Algorytm" IsChecked="True" Margin="0,3"/>

                <RadioButton x:Name="LosowyRadioBox" Content="Losowy algorytm" GroupName="Algorytm" Margin="0,3"/>
            </StackPanel>
        </GroupBox>

        <!-- Przycisk rozpoczęcia -->
        <Button x:Name="RozpocznijButton" Content="Rozpocznij" Grid.Row="7" Grid.Column="1" VerticalAlignment="Top" Height="40"/>

        <!-- Status -->
        <Label Content="Status:" Grid.Row="8" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

        <Label x:Name="StatusLabel" Content="Oczekiwanie na konfigurację" Grid.Row="8" Grid.Column="1"/>

        <!-- Postęp -->
        <Label Content="Który znak:" Grid.Row="9" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

        <Label x:Name="KtoryZnak" Content="0/0" Grid.Row="9"  Grid.Column="1"/>
    </Grid>
</Window>
